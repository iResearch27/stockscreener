//@version=6
indicator("Multi-Stock Turnaround Screener", overlay=false, max_labels_count=50)

// ============================================================
// SETUP: List your stocks below, ONE PER LINE (NSE format shown).
// To add a stock: just add a new line here. Nothing else to edit —
// the table and alert message size themselves automatically.
// Hard cap: 40 symbols (TradingView's request.security() limit).
// ============================================================
symbolListInput = input.text_area("NSE:AXISBANK\nNSE:ICICIBANK\nNSE:KOTAKBANK\nNSE:ACE\nNSE:APTUS\nNSE:AAVAS\nNSE:VBL\nNSE:SENCO\nNSE:PNGJL\nNSE:LUPIN\nNSE:KPIGREEN\nNSE:HDFCBANK\nNSE:GENUSPOWER\nNSE:MGL\nNSE:RELIANCE\nNSE:TIMETECHNO\nNSE:WAAREEENER\nNSE:WAAREERTL\nNSE:POWERMECH\nNSE:UPL\nNSE:TEXRAIL", "Stock List (one per line)")
maxSymbols = 40

minConfirmedScore = input.int(4, "Min CONFIRMED score to flag (out of 6)", minval=1, maxval=6, group="Thresholds")
minEarlyScore      = input.int(4, "Min EARLY score to flag (out of 6)",     minval=1, maxval=6, group="Thresholds")
obvLookback   = input.int(10, "OBV lookback (bars) — confirmed check",     minval=3,  group="Lookbacks")
obvDivLookback = input.int(15, "OBV lookback (bars) — divergence check",   minval=5,  group="Lookbacks")
swingLookback  = input.int(10, "Swing low lookback (bars)",                minval=3,  group="Lookbacks")
nearPct        = input.float(5.0, "'Near SMA50' threshold (%)",            minval=0.5, group="Lookbacks")

// ============================================================
// Core scoring function — evaluated per-symbol via request.security
// ============================================================
f_turnaround() =>
    smaFast  = ta.sma(close, 50)
    smaSlow  = ta.sma(close, 200)
    sma20    = ta.sma(close, 20)
    rsiVal   = ta.rsi(close, 14)
    [macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
    hist     = macdLine - signalLine
    obvVal   = ta.obv

    c1_priceAboveFast = close > smaFast
    c2_priceAboveSlow = close > smaSlow
    c3_goldenCross     = ta.crossover(smaFast, smaSlow) or (smaFast > smaSlow and smaFast[5] <= smaSlow[5])
    c4_rsiReclaim       = ta.crossover(rsiVal, 50) or (rsiVal > 50 and rsiVal[3] <= 50)
    c5_macdBullCross     = ta.crossover(macdLine, signalLine)
    c6_obvRising          = obvVal > obvVal[obvLookback]
    confirmedScore = (c1_priceAboveFast ? 1 : 0) + (c2_priceAboveSlow ? 1 : 0) + (c3_goldenCross ? 1 : 0) + (c4_rsiReclaim ? 1 : 0) + (c5_macdBullCross ? 1 : 0) + (c6_obvRising ? 1 : 0)

    e1_macdHistRising    = hist > hist[3] and hist < 0
    e2_rsiTroughRecovery = rsiVal > rsiVal[5] and rsiVal[5] < 35
    e3_higherSwingLow    = ta.lowest(close, swingLookback) > ta.lowest(close, swingLookback)[swingLookback]
    e4_obvDivergence     = obvVal > obvVal[obvDivLookback] and close < close[obvDivLookback]
    pctToSMA50           = (smaFast - close) / close * 100
    e5_nearingSMA50      = pctToSMA50 > 0 and pctToSMA50 < nearPct
    e6_reclaim20MA       = ta.crossover(close, sma20)
    earlyScore = (e1_macdHistRising ? 1 : 0) + (e2_rsiTroughRecovery ? 1 : 0) + (e3_higherSwingLow ? 1 : 0) + (e4_obvDivergence ? 1 : 0) + (e5_nearingSMA50 ? 1 : 0) + (e6_reclaim20MA ? 1 : 0)

    confDetail = "Price > SMA50: " + (c1_priceAboveFast ? "Y" : "N") +
                 "\nPrice > SMA200: " + (c2_priceAboveSlow ? "Y" : "N") +
                 "\nGolden Cross: " + (c3_goldenCross ? "Y" : "N") +
                 "\nRSI Reclaimed 50: " + (c4_rsiReclaim ? "Y" : "N") +
                 "\nMACD Bull Cross: " + (c5_macdBullCross ? "Y" : "N") +
                 "\nOBV Rising: " + (c6_obvRising ? "Y" : "N")

    earlyDetail = "MACD Hist Rising (still neg): " + (e1_macdHistRising ? "Y" : "N") +
                  "\nRSI Recovering from Oversold: " + (e2_rsiTroughRecovery ? "Y" : "N") +
                  "\nHigher Swing Low: " + (e3_higherSwingLow ? "Y" : "N") +
                  "\nOBV Bullish Divergence: " + (e4_obvDivergence ? "Y" : "N") +
                  "\nNearing SMA50 (<" + str.tostring(nearPct, "#.#") + "%): " + (e5_nearingSMA50 ? "Y" : "N") +
                  "\nReclaimed 20 SMA: " + (e6_reclaim20MA ? "Y" : "N")

    [confirmedScore, earlyScore, close, rsiVal, pctToSMA50, confDetail, earlyDetail]

// ============================================================
// Dashboard table + single dynamic alert — auto-sized to your list
// ============================================================
f_colorForScore(s) =>
    s >= 5 ? color.new(color.green, 0) : s >= 4 ? color.new(color.green, 40) : s >= 3 ? color.new(color.orange, 60) : color.new(color.red, 70)

if barstate.islast
    rawLines = str.split(symbolListInput, "\n")

    syms   = array.new<string>()
    prices = array.new<float>()
    rsis   = array.new<float>()
    pcts   = array.new<float>()
    earlys = array.new<int>()
    confs  = array.new<int>()
    earlyDetails = array.new<string>()
    confDetails  = array.new<string>()

    confFlagList = ""
    earlyFlagList = ""
    droppedCount = 0

    for i = 0 to array.size(rawLines) - 1
        s = str.trim(array.get(rawLines, i))
        if s != "" and not str.startswith(s, "//")
            if array.size(syms) < maxSymbols
                [cs, es, price, rsi, pct, cd, ed] = request.security(s, timeframe.period, f_turnaround())
                array.push(syms, s)
                array.push(prices, price)
                array.push(rsis, rsi)
                array.push(pcts, pct)
                array.push(earlys, es)
                array.push(confs, cs)
                array.push(earlyDetails, ed)
                array.push(confDetails, cd)
                if cs >= minConfirmedScore
                    confFlagList := confFlagList + s + ", "
                if es >= minEarlyScore
                    earlyFlagList := earlyFlagList + s + ", "
            else
                droppedCount := droppedCount + 1

    if confFlagList != "" or earlyFlagList != ""
        msg = (earlyFlagList != "" ? "EARLY: " + earlyFlagList : "") + (confFlagList != "" ? " | CONFIRMED: " + confFlagList : "")
        alert(msg, alert.freq_once_per_bar_close)

    extraRows = droppedCount > 0 ? 1 : 0
    dash = table.new(position.top_right, 6, array.size(syms) + 3 + extraRows, border_width=1, border_color=color.gray, bgcolor=color.new(color.black, 70))

    table.cell(dash, 0, 0, "", bgcolor=color.new(color.black, 100))
    table.cell(dash, 0, 1, "", bgcolor=color.new(color.black, 100))

    table.cell(dash, 0, 2, "Symbol",     text_color=color.white, bgcolor=color.new(color.blue, 50))
    table.cell(dash, 1, 2, "Price",      text_color=color.white, bgcolor=color.new(color.blue, 50))
    table.cell(dash, 2, 2, "RSI",        text_color=color.white, bgcolor=color.new(color.blue, 50))
    table.cell(dash, 3, 2, "% to SMA50", text_color=color.white, bgcolor=color.new(color.blue, 50))
    table.cell(dash, 4, 2, "Early/6",     text_color=color.white, bgcolor=color.new(color.blue, 50))
    table.cell(dash, 5, 2, "Confirmed/6", text_color=color.white, bgcolor=color.new(color.blue, 50))

    for i = 0 to array.size(syms) - 1
        row = i + 3
        table.cell(dash, 0, row, array.get(syms, i), text_color=color.white)
        table.cell(dash, 1, row, str.tostring(array.get(prices, i), format.mintick), text_color=color.white)
        table.cell(dash, 2, row, str.tostring(array.get(rsis, i), "#.##"), text_color=color.white)
        table.cell(dash, 3, row, str.tostring(array.get(pcts, i), "#.##") + "%", text_color=color.white)
        table.cell(dash, 4, row, str.tostring(array.get(earlys, i)) + "/6", text_color=color.white, bgcolor=f_colorForScore(array.get(earlys, i)), tooltip=array.get(earlyDetails, i))
        table.cell(dash, 5, row, str.tostring(array.get(confs, i)) + "/6",  text_color=color.white, bgcolor=f_colorForScore(array.get(confs, i)),  tooltip=array.get(confDetails, i))

    if droppedCount > 0
        table.cell(dash, 0, array.size(syms) + 3, "WARNING: " + str.tostring(droppedCount) + " symbol(s) dropped — 40 max", text_color=color.white, bgcolor=color.new(color.red, 30))
